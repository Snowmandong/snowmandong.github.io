---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'About Maiyu — Web Development Outsourcing Studio',
  description:
    'Learn about Maiyu, an engineering-first web development studio helping global businesses build fast, high-converting websites.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget *************** -->
  <HeroText
    tagline="About Maiyu"
    title="Engineering High-Performance Websites for Global Businesses"
    subtitle="We bridge modern web engineering with conversion-focused design—helping companies worldwide launch fast, reliable, and scalable websites without agency bloat."
  />

  <!-- Story / Mission Content -->
  <Content
    isReversed
    tagline="Our Philosophy"
    title="Why We Built Maiyu Differently"
    items={[
      {
        title: 'Direct Access to Senior Engineers',
        description:
          'You communicate directly with the developers and designers building your site—no layers of middlemen slowing things down.',
      },
      {
        title: 'Performance Is Non-Negotiable',
        description:
          'We reject heavy, insecure page builders in favor of clean, modern code that loads instantaneously and ranks well on Google.',
      },
      {
        title: 'Transparent & Honest Pricing',
        description:
          'Clear deliverables, fixed milestones, and 100% source code ownership from day one.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=2071&q=80',
      alt: 'Maiyu Web Engineering Team',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Your Reliable Technical Outsourcing Partner
      </h3>
      Whether you need a complete corporate website from scratch or an agile development partner to execute your UI designs, we deliver on time and on budget.
    </Fragment>
  </Content>

  <!-- Core Values -->
  <Features2
    tagline="How We Work"
    title="Our Core Standards"
    items={[
      {
        title: 'Speed & Efficiency',
        description: 'Streamlined workflows allow us to take projects from concept to live launch in 7–14 business days.',
        icon: 'tabler:bolt',
      },
      {
        title: 'SEO-First Architecture',
        description: 'Every page is structured with clean semantic markup, fast asset delivery, and proper metadata.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'Responsive Global Support',
        description: 'Fast, clear communication via Email and WhatsApp across North American, European, and Asian time zones.',
        icon: 'tabler:world',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Stats Widget ****************** -->
  <Stats
    stats={[
      { title: 'Years of Experience', amount: '10+' },
      { title: 'Projects Completed', amount: '120+' },
      { title: 'Repeat & Referral Rate', amount: '85%' },
      { title: 'Response Time', amount: '< 2h' },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Work With Us',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Let’s Build Something Great Together</Fragment>
    <Fragment slot="subtitle">
      Reach out to <strong>dong@tiantongfu.com</strong> or WhatsApp <strong>+86 199 0397 0011</strong> to discuss your next web project.
    </Fragment>
  </CallToAction>
</Layout>