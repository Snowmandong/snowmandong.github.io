---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing & Web Development Packages',
  description:
    'Transparent website development pricing from Maiyu. Starter websites from $599, Growth Marketing Websites starting at $999, and custom e-commerce solutions.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget *************** -->
  <HeroText
    tagline="Pricing & Packages"
    title="Transparent, Fixed-Price Web Development"
    subtitle="No surprise hourly bills or hidden agency markups. Choose a package that matches your growth stage, or request a custom quote."
  />

  <!-- Pricing Widget **************** -->
  <Prices
    prices={[
      {
        title: 'Starter Website',
        subtitle: 'Clean, fast online presence for startups & small businesses',
        price: 599,
        period: 'one-time project',
        items: [
          { description: 'Up to 5 custom responsive pages' },
          { description: 'Modern mobile-first UI/UX design' },
          { description: 'Inquiry form & WhatsApp direct chat button' },
          { description: 'On-page SEO tags, SSL & XML sitemap' },
          { description: 'Global CDN deployment & source code handover' },
          { description: '5–7 business days delivery' },
        ],
        callToAction: {
          text: 'Select Starter ($599)',
          href: '/contact?plan=starter',
        },
      },
      {
        title: 'Growth Marketing Site',
        subtitle: 'Our flagship package for B2B companies, exporters & brands',
        price: 999,
        period: 'starting at / project',
        hasRibbon: true,
        ribbonTitle: 'Most Popular',
        items: [
          { description: 'Up to 12 custom pages + Blog / News system' },
          { description: 'Conversion-focused layout & copy refinement' },
          { description: 'Advanced Technical SEO & JSON-LD Schema' },
          { description: '95+ Google PageSpeed performance optimization' },
          { description: 'Google Analytics & Search Console integration' },
          { description: '30 days free post-launch technical support' },
        ],
        callToAction: {
          text: 'Start Growth Site ($999+)',
          href: '/contact?plan=growth',
        },
      },
      {
        title: 'Custom & E-Commerce',
        subtitle: 'Tailored web platforms, D2C stores & complex integrations',
        price: 1999,
        period: 'starting at / project',
        items: [
          { description: 'Unlimited product/service pages & CMS' },
          { description: 'Stripe / PayPal global payment integration' },
          { description: 'Multi-language support & custom API workflows' },
          { description: 'AI chatbot / automated lead routing setup' },
          { description: 'Dedicated project manager & priority delivery' },
          { description: '60 days priority support & full code ownership' },
        ],
        callToAction: {
          text: 'Request Custom Quote',
          href: '/contact?plan=custom',
        },
      },
    ]}
  />

  <!-- Add-ons & Included Features -->
  <Features2
    tagline="Included in Every Build"
    title="Standard Guarantees Across All Packages"
    subtitle="Every project built by Maiyu meets strict international engineering and SEO standards."
    items={[
      {
        title: '100% Source Code Ownership',
        description: 'You receive the complete Git repository and build files. You are never locked into proprietary software.',
        icon: 'tabler:brand-git',
      },
      {
        title: 'Zero Monthly Platform Fees',
        description: 'We deploy on modern static/edge infrastructure (GitHub Pages, Cloudflare, Vercel) with near-zero hosting overhead.',
        icon: 'tabler:cloud-check',
      },
      {
        title: 'Cross-Device Responsiveness',
        description: 'Tested across iOS, Android, tablets, and major desktop browsers to guarantee pixel-perfect rendering.',
        icon: 'tabler:devices',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- FAQs Widget ******************* -->
  <FAQs
    title="Pricing & Billing FAQs"
    items={[
      {
        title: 'Are domain name and hosting included in the package price?',
        description:
          'We assist you in registering your domain (typically ~$10–$15/year) and setting up ultra-fast global cloud hosting under your own account so you retain 100% administrative control.',
      },
      {
        title: 'How does the 50/50 payment schedule work?',
        description:
          'You pay 50% upfront to initiate design and development. Once your website is built on our staging link and you have reviewed and approved everything, you pay the remaining 50% for final domain launch and code handover.',
      },
      {
        title: 'What if I need extra pages or custom features later?',
        description:
          'Because our websites are built with modular component architecture, adding new pages, languages, or features later is fast and affordable.',
      },
      {
        title: 'Do you offer ongoing monthly maintenance?',
        description:
          'All packages include 30–60 days of free post-launch support. After that, you can manage content yourself or opt into an optional low-cost maintenance plan.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Your Exact Quote',
        href: '/contact',
        icon: 'tabler:file-dollar',
      },
    ]}
  >
    <Fragment slot="title">Have a specific budget or feature list?</Fragment>
    <Fragment slot="subtitle">
      Email <strong>dong@tiantongfu.com</strong> or message us on WhatsApp (<strong>+86 199 0397 0011</strong>) for a custom breakdown.
    </Fragment>
  </CallToAction>
</Layout>