---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Web Development & Outsourcing Services',
  description:
    'Custom corporate websites, high-converting marketing sites starting at $999, e-commerce stores, and technical SEO optimization by Maiyu.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget *************** -->
  <HeroText
    tagline="Our Services"
    title="Full-Stack Web Development Tailored for Global Growth"
    subtitle="Whether you are launching a new brand, scaling cross-border sales, or modernizing a legacy site, Maiyu delivers fast, reliable, conversion-driven websites."
  />

  <!-- Service 1: Custom Corporate Websites -->
  <Content
    id="corporate"
    isReversed
    tagline="Enterprise & B2B"
    title="Custom Corporate Websites"
    items={[
      {
        title: 'Bespoke Brand Identity & UI/UX',
        description:
          'Tailored visual layouts designed from scratch to reflect your company’s authority, professionalism, and industry positioning.',
      },
      {
        title: 'Multi-Language & Global Readiness',
        description:
          'Clean architecture supporting English and multi-regional localization to help you win trust with international buyers.',
      },
      {
        title: '100% Ownership & Zero Lock-In',
        description:
          'Full source code, design assets, and repository handover upon completion—no recurring proprietary platform fees.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=2069&q=80',
      alt: 'Corporate Website Design',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Build Immediate Credibility Online
      </h3>
      Your corporate site is the digital headquarters of your business. We structure every section to turn first-time visitors into qualified leads.
    </Fragment>
  </Content>

  <!-- Service 2: Marketing & Landing Pages -->
  <Content
    id="marketing"
    isAfterContent
    tagline="Conversion Focused · From $999"
    title="High-Converting Marketing & Independent Sites"
    items={[
      {
        title: 'Persuasive Conversion Funnels',
        description:
          'Strategic page hierarchy, clear value propositions, social proof blocks, and frictionless inquiry forms designed to maximize ROI.',
      },
      {
        title: 'Instant Lead Capture & WhatsApp Integration',
        description:
          'Connect visitors directly to your sales team via one-click WhatsApp chat, email forms, and CRM webhooks.',
      },
      {
        title: 'Ad-Campaign Ready Performance',
        description:
          'Sub-second load times ensure you never waste Google Ads or Meta Ads spend on slow, high-bounce landing pages.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=2070&q=80',
      alt: 'Marketing Analytics and Conversion',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Turn Traffic into Measurable Revenue
      </h3>
      Starting at <strong>$999</strong>, our Growth Marketing Websites are built specifically for exporters, SaaS startups, and service brands seeking global customer acquisition.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Service 3: E-Commerce Development -->
  <Content
    id="ecommerce"
    isReversed
    isAfterContent
    tagline="Cross-Border Retail & D2C"
    title="E-Commerce & Online Store Development"
    items={[
      {
        title: 'Seamless Product Catalog & Filtering',
        description:
          'Intuitive category navigation, high-resolution product galleries, and mobile-first browsing experiences.',
      },
      {
        title: 'Global Payment & Checkout Flows',
        description:
          'Integration with Stripe, PayPal, credit cards, and regional payment gateways for smooth international transactions.',
      },
      {
        title: 'Easy Inventory & Order Management',
        description:
          'User-friendly admin workflows so your team can update products, pricing, and promotions effortlessly.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=2070&q=80',
      alt: 'E-Commerce Storefront Development',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Sell Globally Without Technical Friction
      </h3>
      We build fast, reliable online stores engineered to reduce cart abandonment and scale alongside your catalog.
    </Fragment>
  </Content>

  <!-- Service 4: Technical SEO & Speed -->
  <Features2
    id="seo"
    tagline="Optimization & Care"
    title="Technical SEO, Speed Boost & Ongoing Maintenance"
    subtitle="Already have a website that loads slowly or fails to rank on Google? We audit, refactor, and optimize existing sites."
    items={[
      {
        title: '95+ Google PageSpeed Optimization',
        description:
          'Image compression, modern static/edge rendering, code minification, and Core Web Vitals tuning.',
        icon: 'tabler:gauge',
      },
      {
        title: 'On-Page & Schema SEO Architecture',
        description:
          'Semantic heading structures, Open Graph tags, JSON-LD structured data, canonical URLs, and XML sitemaps.',
        icon: 'tabler:search',
      },
      {
        title: 'Website Migration & Redesign',
        description:
          'Safely upgrade outdated WordPress or legacy HTML sites to modern Astro/React stacks without losing search rankings.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Security, SSL & Cloud Hosting Setup',
        description:
          'Global CDN deployment (Cloudflare / Vercel / AWS), HTTPS configuration, and automated backups.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'AI Chatbot & Form Automation',
        description:
          'Embed custom AI customer support assistants and automated email notifications into your website.',
        icon: 'tabler:robot',
      },
      {
        title: 'Dedicated Outsource Partner',
        description:
          'Flexible retainer or per-project support with direct communication via WhatsApp and Email.',
        icon: 'tabler:users',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Request a Free Proposal',
        href: '/contact',
        icon: 'tabler:mail',
      },
      {
        text: 'Chat on WhatsApp',
        href: 'https://wa.me/8619903970011?text=Hi%20Maiyu%2C%20I%20would%20like%20to%20learn%20more%20about%20your%20web%20services.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">Not sure which solution fits best?</Fragment>
    <Fragment slot="subtitle">
      Send us your requirements or reference websites—we will recommend the most cost-effective tech stack within 24 hours.
    </Fragment>
  </CallToAction>
</Layout>