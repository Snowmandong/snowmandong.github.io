---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Prices from '~/components/widgets/Pricing.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Maiyu — Custom Web Development & High-Converting Websites',
  description:
    'Professional web development outsourcing studio. We design and build fast, SEO-ready corporate websites, marketing sites starting at $999, and custom web applications.',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    email: 'dong@tiantongfu.com',
    telephone: '+86-199-0397-0011',
    priceRange: '$$',
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero Widget ******************* -->
  <Hero
    tagline="Global Web Development & Outsourcing Studio"
    actions={[
      {
        variant: 'primary',
        text: 'Start Your Project',
        href: '/contact',
        icon: 'tabler:rocket',
      },
      {
        text: 'Chat on WhatsApp',
        href: 'https://wa.me/8619903970011?text=Hi%20Maiyu%2C%20I%20would%20like%20to%20discuss%20a%20website%20project.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=2070&q=80',
      alt: 'Maiyu Web Development Showcase',
    }}
  >
    <Fragment slot="title">
      Websites Engineered to <span class="text-accent dark:text-white">Convert Visitors</span> into Global Clients
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">Maiyu</span> is your dedicated web development partner. We design, build, and launch blazing-fast corporate sites, marketing websites (from <span class="font-semibold text-blue-600 dark:text-blue-400">$999</span>), and custom web platforms with 100% source code ownership.
    </Fragment>
  </Hero>

  <!-- SocialProof Widget ************ -->
  <SocialProof
    id="proof"
    classes={{ container: '!pb-14 md:!pb-20' }}
    items={[
      {
        value: '10+ Yrs',
        label: 'web engineering experience',
        icon: 'tabler:award',
        color: 'text-amber-400',
      },
      {
        value: '99/100',
        label: 'Google PageSpeed score',
        icon: 'tabler:gauge',
        color: 'text-emerald-500',
      },
      {
        value: '7–14 Days',
        label: 'fast project turnaround',
        icon: 'tabler:bolt',
        color: 'text-sky-500',
      },
    ]}
  />

  <!-- Features Widget *************** -->
  <Features
    id="features"
    tagline="Our Expertise"
    title="End-to-End Web Outsourcing Solutions"
    subtitle="From initial wireframe to global cloud deployment, we handle every technical detail so you can focus on growing your business."
    items={[
      {
        title: 'Custom Corporate Websites',
        description:
          'Bespoke, brand-aligned multi-page websites designed to establish immediate authority and trust with international B2B and B2C buyers.',
        icon: 'tabler:building-skyscraper',
      },
      {
        title: 'High-Converting Marketing Sites',
        description:
          'Conversion-focused landing pages and independent brand sites engineered with clear calls-to-action, lead capture forms, and WhatsApp integration.',
        icon: 'tabler:chart-arrows-vertical',
      },
      {
        title: 'E-Commerce & Online Stores',
        description:
          'Scalable cross-border online stores featuring smooth product catalogs, secure global payment gateways, and mobile-first checkout flows.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Technical SEO & Core Web Vitals',
        description:
          'Clean semantic HTML, automated XML sitemaps, schema markup, and sub-second load times built to rank higher on Google from day one.',
        icon: 'tabler:seo',
      },
      {
        title: 'Responsive UI/UX Redesign',
        description:
          'Transform outdated, slow websites into modern, pixel-perfect digital experiences that look stunning across desktop, tablet, and mobile.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Dedicated Maintenance & Support',
        description:
          'Reliable post-launch technical support, security updates, content adjustments, and global CDN hosting setup with zero headaches.',
        icon: 'tabler:headset',
      },
    ]}
  />

  <!-- Content Widget 1 **************** -->
  <Content
    isReversed
    tagline="Why Choose Maiyu"
    title="Modern Tech Stack. Zero Bloated Templates."
    items={[
      {
        title: 'Sub-Second Loading Speed',
        description:
          'We build with modern frameworks like Astro, React, and Tailwind CSS—eliminating sluggish legacy plugins so your visitors never bounce.',
      },
      {
        title: 'Built for International Audiences',
        description:
          'We understand Western UX expectations: clean typography, intuitive navigation, clear value propositions, and frictionless inquiry paths.',
      },
      {
        title: '100% Source Code & Asset Ownership',
        description:
          'No vendor lock-in. Upon completion, you receive full ownership of your codebase, repository, domain, and cloud hosting accounts.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=2070&q=80',
      alt: 'Clean modern web development code',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Engineered for Performance & Trust
      </h3>
      Your website is your 24/7 global sales representative. We make sure it leaves an unforgettable first impression.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Pricing Widget **************** -->
  <Prices
    id="pricing"
    tagline="Transparent Pricing"
    title="Flexible Packages for Every Stage"
    subtitle="Clear, fixed-price packages with no hidden fees. Need custom functionality? Contact us for a tailored proposal within 24 hours."
    prices={[
      {
        title: 'Starter Website',
        subtitle: 'Ideal for startups, portfolios & small local businesses',
        price: 599,
        period: 'one-time project',
        items: [
          {
            description: 'Up to 5 custom responsive pages',
          },
          {
            description: 'Modern UI/UX design & mobile optimization',
          },
          {
            description: 'Contact form & WhatsApp chat button',
          },
          {
            description: 'Basic on-page SEO & SSL setup',
          },
          {
            description: '7-day fast delivery',
          },
        ],
        callToAction: {
          text: 'Get Started',
          href: '/contact?plan=starter',
        },
      },
      {
        title: 'Growth Marketing Site',
        subtitle: 'Best for B2B companies, exporters & growing brands',
        price: 999,
        period: 'starting at / project',
        hasRibbon: true,
        ribbonTitle: 'Most Popular',
        items: [
          {
            description: 'Up to 12 custom-designed pages + Blog/News',
          },
          {
            description: 'Conversion-focused copy & layout structure',
          },
          {
            description: 'Advanced Technical SEO, Schema & Sitemap',
          },
          {
            description: '95+ Google PageSpeed performance tuning',
          },
          {
            description: '30 days free post-launch support',
          },
        ],
        callToAction: {
          text: 'Order Growth Package',
          href: '/contact?plan=growth',
        },
      },
      {
        title: 'Custom & E-Commerce',
        subtitle: 'For online stores, SaaS & complex web applications',
        price: 1999,
        period: 'starting at / project',
        items: [
          {
            description: 'Unlimited product/service pages & CMS',
          },
          {
            description: 'Global payment & multi-language integration',
          },
          {
            description: 'Custom API, CRM, or AI chatbot integration',
          },
          {
            description: 'Dedicated project manager & priority support',
          },
          {
            description: 'Full source code & cloud architecture handover',
          },
        ],
        callToAction: {
          text: 'Request Custom Quote',
          href: '/contact?plan=custom',
        },
      },
    ]}
  />

  <!-- Steps Widget ****************** -->
  <Steps
    id="process"
    title="How We Deliver Your Website in 4 Simple Steps"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Discovery & Free Quote</span>',
        description:
          'Share your goals, reference sites, and requirements via email or WhatsApp. Within 24 hours, you receive a clear scope, timeline, and fixed quote.',
        icon: 'tabler:messages',
      },
      {
        title: 'Step 2: <span class="font-medium">UI/UX Wireframe & Design</span>',
        description:
          'We craft a modern visual layout tailored to your brand identity. You review and approve the design before full-scale coding begins.',
        icon: 'tabler:palette',
      },
      {
        title: 'Step 3: <span class="font-medium">Agile Development & SEO Setup</span>',
        description:
          'Our engineers build your site with clean, fast code, mobile responsiveness, lead forms, analytics, and Google-ready SEO architecture.',
        icon: 'tabler:code',
      },
      {
        title: 'Step 4: <span class="font-medium">Launch & Handover</span>',
        description:
          'After thorough cross-browser QA testing, we deploy your site to your domain and hand over 100% of the source code and credentials.',
        icon: 'tabler:rocket',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=987&q=80',
      alt: 'Web development team collaboration',
    }}
  />

  <!-- FAQs Widget ******************* -->
  <FAQs
    id="faqs"
    title="Frequently Asked Questions"
    subtitle="Everything you need to know about outsourcing your website development to Maiyu."
    tagline="FAQs"
    schema
    items={[
      {
        title: 'How long does it take to build a website?',
        description:
          'A standard Starter website takes about 5–7 business days. A Growth Marketing website ($999+) typically takes 10–14 business days, depending on how quickly content and feedback are shared.',
      },
      {
        title: 'Do I own the website and source code after completion?',
        description:
          'Yes, 100%. Once the project is completed, all design assets, source code, GitHub repositories, and hosting accounts belong entirely to you.',
      },
      {
        title: 'What are the payment terms?',
        description:
          'We keep it simple and fair: 50% deposit to kick off the project, and the remaining 50% only after you review and approve the completed website prior to final launch.',
      },
      {
        title: 'Will my website be mobile-friendly and SEO-optimized?',
        description:
          'Absolutely. Every website we build is 100% responsive across phones, tablets, and desktops, and includes clean semantic code, meta tags, fast loading speeds, and an XML sitemap for Google indexing.',
      },
      {
        title: 'Can you redesign our existing outdated website?',
        description:
          'Yes. We can migrate your existing content, upgrade the visual design to modern international standards, improve page speed, and preserve your existing SEO rankings.',
      },
      {
        title: 'How do we communicate during the project?',
        description:
          'You can reach us directly via Email (<a href="mailto:dong@tiantongfu.com" class="underline">dong@tiantongfu.com</a>) or WhatsApp (<a href="https://wa.me/8619903970011" class="underline">+86 199 0397 0011</a>) for fast, responsive updates across time zones.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->
  <Stats
    id="stats"
    countUp
    stats={[
      { title: 'Projects Delivered', amount: '120+' },
      { title: 'Client Satisfaction', amount: '99%' },
      { title: 'Avg. PageSpeed Score', amount: '98' },
      { title: 'Quote Turnaround', amount: '24h' },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get a Free Quote',
        href: '/contact',
        icon: 'tabler:mail',
      },
      {
        text: 'WhatsApp: +86 199 0397 0011',
        href: 'https://wa.me/8619903970011?text=Hi%20Maiyu%2C%20I%20need%20a%20quote%20for%20a%20website.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Launch Your <br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Next Website?</span>
    </Fragment>

    <Fragment slot="subtitle">
      Tell us about your project today and get a tailored roadmap & quote within 24 hours. <br class="hidden md:inline" />
      Email: <strong>dong@tiantongfu.com</strong> · WhatsApp: <strong>+86 199 0397 0011</strong>
    </Fragment>
  </CallToAction>
</Layout>