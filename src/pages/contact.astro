---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact Us & Request a Free Website Quote',
  description:
    'Get a free website development quote from Maiyu within 24 hours. Contact us via Email (dong@tiantongfu.com) or WhatsApp (+86 199 0397 0011).',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget *************** -->
  <HeroText
    tagline="Get a Free Quote"
    title="Tell Us About Your Website Project"
    subtitle="Fill out the brief form below or message us directly on WhatsApp. We respond to every inquiry with a tailored roadmap and fixed quote within 24 hours."
  />

  <!-- Interactive Quote Form Section -->
  <section class="px-4 py-8 sm:px-6 mx-auto lg:px-8 lg:py-12 max-w-4xl">
    <div class="rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-lg">
      <form id="quote-form" class="space-y-6">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm font-medium mb-2 dark:text-slate-200">Your Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. John Smith"
              class="w-full rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm focus:border-blue-600 focus:outline-none"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium mb-2 dark:text-slate-200">Work Email *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="john@company.com"
              class="w-full rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm focus:border-blue-600 focus:outline-none"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <label for="package" class="block text-sm font-medium mb-2 dark:text-slate-200">Interested Package</label>
            <select
              id="package"
              name="package"
              class="w-full rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm focus:border-blue-600 focus:outline-none"
            >
              <option value="Growth Marketing Site ($999+)">Growth Marketing Site (Starting at $999) — Popular</option>
              <option value="Starter Website ($599)">Starter Website ($599)</option>
              <option value="Custom & E-Commerce ($1,999+)">Custom & E-Commerce (Starting at $1,999)</option>
              <option value="Website Redesign / SEO Boost">Website Redesign / Speed & SEO Boost</option>
            </select>
          </div>
          <div>
            <label for="whatsapp" class="block text-sm font-medium mb-2 dark:text-slate-200">WhatsApp / Phone (Optional)</label>
            <input
              type="text"
              id="whatsapp"
              name="whatsapp"
              placeholder="+1 555 019 2834"
              class="w-full rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm focus:border-blue-600 focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label for="details" class="block text-sm font-medium mb-2 dark:text-slate-200">Project Details & Goals *</label>
          <textarea
            id="details"
            name="details"
            rows="4"
            required
            placeholder="Tell us about your business, estimated number of pages, reference websites you like, and target launch timeline..."
            class="w-full rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm focus:border-blue-600 focus:outline-none"
          ></textarea>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <button
            type="submit"
            class="btn-primary flex-1 justify-center py-3.5 px-6 text-base font-semibold cursor-pointer"
          >
            Send Quote Request via Email
          </button>
          <button
            type="button"
            id="whatsapp-submit"
            class="btn flex-1 justify-center py-3.5 px-6 text-base font-semibold border border-emerald-600 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer"
          >
            Send Instantly via WhatsApp
          </button>
        </div>

        <p class="text-xs text-center text-muted">
          Prefer direct contact? Email us at <a href="mailto:dong@tiantongfu.com" class="underline font-medium">dong@tiantongfu.com</a> or chat on WhatsApp at <a href="https://wa.me/8619903970011" target="_blank" class="underline font-medium">+86 199 0397 0011</a>.
        </p>
      </form>
    </div>
  </section>

  <!-- Direct Contact Channels -->
  <Features2
    tagline="Direct Channels"
    title="We Are Here to Help"
    items={[
      {
        title: 'WhatsApp Fast Chat',
        description: '+86 199 0397 0011 — Fastest response for quick questions, voice notes, and project scoping.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Business Email',
        description: 'dong@tiantongfu.com — Send RFPs, design files, or detailed technical specifications.',
        icon: 'tabler:mail',
      },
      {
        title: '24-Hour Proposal Guarantee',
        description: 'Every inquiry receives a clear timeline, tech recommendation, and transparent quote within 1 business day.',
        icon: 'tabler:clock-check',
      },
    ]}
  />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Auto-select package from URL query (?plan=starter / growth / custom)
      const params = new URLSearchParams(window.location.search);
      const plan = params.get('plan');
      const selectEl = document.getElementById('package');
      if (plan && selectEl) {
        if (plan === 'starter') selectEl.selectedIndex = 1;
        else if (plan === 'growth') selectEl.selectedIndex = 0;
        else if (plan === 'custom') selectEl.selectedIndex = 2;
      }

      const form = document.getElementById('quote-form');
      const waBtn = document.getElementById('whatsapp-submit');

      function getFormSummary() {
        const name = document.getElementById('name').value.trim() || 'Prospective Client';
        const email = document.getElementById('email').value.trim() || 'Not provided';
        const pkg = document.getElementById('package').value;
        const wa = document.getElementById('whatsapp').value.trim() || 'Not provided';
        const details = document.getElementById('details').value.trim() || 'Interested in building a website.';
        return { name, email, pkg, wa, details };
      }

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const data = getFormSummary();
          const subject = encodeURIComponent(`Website Quote Request: ${data.pkg} - ${data.name}`);
          const body = encodeURIComponent(
            `Hi Maiyu Team,\n\nI would like to request a quote for a website project:\n\n` +
            `- Name: ${data.name}\n` +
            `- Email: ${data.email}\n` +
            `- WhatsApp/Phone: ${data.wa}\n` +
            `- Package: ${data.pkg}\n\n` +
            `Project Details:\n${data.details}\n`
          );
          window.location.href = `mailto:dong@tiantongfu.com?subject=${subject}&body=${body}`;
        });
      }

      if (waBtn) {
        waBtn.addEventListener('click', () => {
          const data = getFormSummary();
          const text = encodeURIComponent(
            `Hi Maiyu! I'd like a website quote.\n` +
            `Name: ${data.name}\n` +
            `Email: ${data.email}\n` +
            `Package: ${data.pkg}\n` +
            `Details: ${data.details}`
          );
          window.open(`https://wa.me/8619903970011?text=${text}`, '_blank');
        });
      }
    });
  </script>
</Layout>